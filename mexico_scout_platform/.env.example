# Copy to .env. Nothing here is required: every value has a default. No paid API key is needed.

# --- Qdrant (local, file-based) ---
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=mx_listings
# Multilingual (Spanish listings). Larger/better: intfloat/multilingual-e5-large (1024 dims; re-ingest if you change it).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM for the CrewAI agents: any local/open model through Ollama, or any LiteLLM-supported endpoint ---
LLM_MODEL=ollama/llama3.1
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
# Hosted free tiers rate-limit by tokens per minute: retry with backoff, and show the agent a shorter page.
LLM_NUM_RETRIES=8
AGENT_MARKDOWN_CHARS=2500
# Example with the hosted Groq free tier (no local model needed):
#   LLM_MODEL=groq/qwen/qwen3.8-27b   LLM_BASE_URL=   LLM_API_KEY=<your Groq key>   LLM_MAX_TOKENS=900
LLM_MAX_TOKENS=4096

# --- Money: MXN per 1 USD. There is no paid FX feed; update this when it matters. ---
USD_MXN_RATE=18.0

# --- Scraping: be polite. Delays are randomised between MIN and MAX seconds per host. ---
PROXY_URL=
IMPERSONATE=chrome
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=9
FETCH_TIMEOUT=30
BROWSER_FALLBACK=true
RESPECT_ROBOTS=true
MAX_PAGES_PER_RUN=12
# Comma separated. Only these hosts are ever fetched.
ALLOWED_DOMAINS=bestcaribbeanproperty.com,moskito.mx,remaxmaya.com,mudafy.com.mx,selvacorealty.com

LOG_LEVEL=INFO
AGENT_VERBOSE=false
