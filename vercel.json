{
  "cleanUrls": true,
  "functions": {
    "api/photos.js": {
      "maxDuration": 10
    },
    "api/geocode.js": {
      "maxDuration": 10
    },
    "api/amenities.js": {
      "maxDuration": 15
    },
    "api/search.js": {
      "maxDuration": 30
    },
    "api/property.js": {
      "maxDuration": 15,
      "includeFiles": "property.html"
    },
    "api/onboard.js": {
      "maxDuration": 15
    },
    "api/my-listings.js": {
      "maxDuration": 15
    },
    "api/leads.js": {
      "maxDuration": 15
    },
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/instagram-publish.js": {
      "maxDuration": 15
    },
    "api/finder.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/invest",
      "destination": "/invest.html"
    },
    {
      "source": "/agents",
      "destination": "/agents.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/resources/:slug",
      "destination": "/article.html?slug=:slug"
    },
    {
      "source": "/agencies",
      "destination": "/agencias"
    },
    {
      "source": "/api/describe",
      "destination": "/api/generate?action=describe"
    },
    {
      "source": "/api/nlsearch",
      "destination": "/api/generate?action=nlsearch"
    },
    {
      "source": "/generar",
      "destination": "/generate"
    },
    {
      "source": "/propiedad/:id",
      "destination": "/api/property?id=:id&format=page"
    },
    {
      "source": "/property/:id",
      "destination": "/api/property?id=:id&format=page"
    },
    {
      "source": "/propiedades-en-:city",
      "destination": "/api/search?city=:city&format=page"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/search?format=sitemap"
    },
    {
      "source": "/agencia/:slug",
      "destination": "/agency?slug=:slug"
    },
    {
      "source": "/agency/:slug",
      "destination": "/agency?slug=:slug"
    },
    {
      "source": "/favoritos",
      "destination": "/favorites"
    },
    {
      "source": "/dashboard/leads",
      "destination": "/dashboard-leads"
    },
    {
      "source": "/invitacion/:code",
      "destination": "/invitacion?c=:code"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(self), microphone=(self), payment=()"
        }
      ]
    }
  ]
}
