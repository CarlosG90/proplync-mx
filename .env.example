# MercadoLibre app credentials — free, from developers.mercadolibre.com.mx.
# Powers /api/listings with real Tulum/Playa del Carmen/Puerto Morelos/Cancún
# inventory. Optional: the site works without these, using the curated sample
# listings below. See README.md "Go live with real inventory" for the
# one-time setup (app registration + browser authorization via api/ml-callback.js).
ML_CLIENT_ID=your_client_id_here
ML_CLIENT_SECRET=your_client_secret_here

# Upstash Redis REST credentials — provisioned automatically via the Vercel
# Marketplace ("vercel integration add upstash/upstash-kv"). Required by
# /api/listings and /api/ml-callback to persist MercadoLibre's rotating
# refresh_token between requests.
KV_REST_API_URL=your_upstash_rest_url_here
KV_REST_API_TOKEN=your_upstash_rest_token_here

# Pexels API key — free, instant signup at https://www.pexels.com/api/
# Powers real property photos for the sample listings (no MercadoLibre needed).
PEXELS_API_KEY=your_key_here
