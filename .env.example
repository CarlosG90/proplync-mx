# EasyBroker API key — real live inventory, requires a paid broker account.
# Get it at app.easybroker.com > Settings > API. Optional: the site works
# without this, using the curated sample listings below.
EASYBROKER_API_KEY=your_key_here

# Pexels API key — free, instant signup at https://www.pexels.com/api/
# Primary source for real property photos: the sample listings, and
# auto-filled photos for /dashboard agency listings created without an
# uploaded image (no EasyBroker needed).
PEXELS_API_KEY=your_key_here

# Pixabay API key — free, instant signup at https://pixabay.com/api/docs/
# Automatic fallback if Pexels has no key set or hits its free-tier rate
# limit (200 req/hour). Optional — Pexels alone is enough, this just adds
# resilience. See api/_lib/photos.js.
PIXABAY_API_KEY=your_key_here

# Groq API key — free, no card required, at https://console.groq.com/keys
# Powers the "Generar descripción con IA" button in the property side panel.
GROQ_API_KEY=your_key_here

# Runway API key — powers the Reel clips in the marketing module: each of the
# agency's own listing photos becomes a short motion clip that the Reel
# renderer composites its text over. Get it at https://dev.runwayml.com
# (Developer Portal > API Keys). The official SDK reads this exact variable
# name, so do not rename it.
#
# UNLIKE every other key here, this one costs real money per use: Runway bills
# credits per generated clip, and one Reel is 4-5 clips. That is why reels are
# capped per month per plan in api/_lib/plans.js (reelsPerMonth) rather than
# being unlimited on Pro the way copy generation is.
#
# Leave it unset and the feature reports itself unavailable (503) instead of
# throwing — the still-photo Reel keeps working, same as it did before.
RUNWAYML_API_SECRET=

# No key needed for the map / nearby-amenities side panel — it uses
# OpenStreetMap's Nominatim (geocoding) and Overpass (amenities) APIs directly.

# Supabase (auth + database for the agent-facing SaaS side: signup, login,
# /dashboard listing management, /dashboard/leads CRM). Provisioned via the
# Vercel Marketplace integration, NOT set manually — `vercel integration add
# supabase` (or the dashboard) injects SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY automatically for all environments, and
# `vercel env pull` syncs them locally. After installing, run
# supabase/schema.sql once in the Supabase Studio SQL editor to create the
# agencies/agency_members/listings/leads tables and RLS policies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Signup gate -------------------------------------------------------------
# /api/onboard is the ONLY way an account is created, and it uses the
# service-role admin API — so Supabase's "allow new users to sign up" toggle
# does NOT close it. This variable does.
#
# UNSET (the default) = signup fully closed; every request gets 403
# signup_closed. Set it to a shared secret and hand that to an agency you are
# onboarding; only someone with the exact code can register. Rotate it by
# changing the value and redeploying — old codes stop working immediately.
SIGNUP_INVITE_CODE=

# --- Lead notifications (optional until a sending domain exists) -------------
# Resend API key. Free tier, no card: https://resend.com/api-keys
# Sending requires a VERIFIED DOMAIN. Leave unset until proplync.mx is
# registered and verified — api/_lib/notify.js no-ops cleanly without it
# rather than bouncing mail from an unverified sender.
RESEND_API_KEY=

# The From: address, on the verified domain. e.g. "Proplync <leads@proplync.mx>"
LEAD_NOTIFY_FROM=

# Public origin, used for dashboard links inside notification emails and for
# the URLs scripts/onboard-agency.mjs prints when handing over an account.
# Defaults to https://proplync-mx.vercel.app when unset.
PUBLIC_SITE_URL=
