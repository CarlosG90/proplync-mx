# EasyBroker API key — real live inventory, requires a paid broker account.
# Get it at app.easybroker.com > Settings > API. Optional: the site works
# without this, using the curated sample listings below.
EASYBROKER_API_KEY=your_key_here

# Pexels API key — free, instant signup at https://www.pexels.com/api/
# Primary source for real property photos: the sample listings, and
# auto-filled photos for /dashboard agency listings created without an
# uploaded image (no EasyBroker needed).
PEXELS_API_KEY=your_key_here

# Pixabay API key — free, instant signup at https://pixabay.com/api/docs/
# Automatic fallback if Pexels has no key set or hits its free-tier rate
# limit (200 req/hour). Optional — Pexels alone is enough, this just adds
# resilience. See api/_lib/photos.js.
PIXABAY_API_KEY=your_key_here

# Groq API key — free, no card required, at https://console.groq.com/keys
# Powers the "Generar descripción con IA" button in the property side panel.
GROQ_API_KEY=your_key_here

# No key needed for the map / nearby-amenities side panel — it uses
# OpenStreetMap's Nominatim (geocoding) and Overpass (amenities) APIs directly.

# Supabase (auth + database for the agent-facing SaaS side: signup, login,
# /dashboard listing management, /dashboard/leads CRM). Provisioned via the
# Vercel Marketplace integration, NOT set manually — `vercel integration add
# supabase` (or the dashboard) injects SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY automatically for all environments, and
# `vercel env pull` syncs them locally. After installing, run
# supabase/schema.sql once in the Supabase Studio SQL editor to create the
# agencies/agency_members/listings/leads tables and RLS policies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
